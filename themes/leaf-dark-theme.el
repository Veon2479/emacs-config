;;; leaf-dark-theme.el --- Port of KDE Kate "Leaf Dark" -*- lexical-binding: t -*-

;; Source: https://github.com/qewer33/leaf-kde/blob/main/kate/Leaf%20Dark.theme

;;; Code:

(deftheme leaf-dark "Port of Kate Leaf Dark (qewer33/leaf-kde).")

(let ((bg       "#2e2c2f")
      (bg-hl    "#343235")
      (bg-sep   "#333134")
      (sel      "#515051")
      (paren    "#656066")
      (fg       "#e1e4dc")
      (fg-dim   "#737576")
      (fg-cur   "#cbcccf")
      (comment  "#7a7c7d")
      (builtin  "#7f8c8d")
      (green    "#729b79")
      (teal     "#489ca5")
      (blue     "#5292c6")
      (yellow   "#ccaa6c")
      (red      "#ba5860")
      (purple   "#8c6aa8")
      (import   "#27ae60"))
  (custom-theme-set-faces
   'leaf-dark
   ;; base UI
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,fg))))
   `(fringe ((t (:background ,bg))))
   `(region ((t (:background ,sel :extend t))))
   `(hl-line ((t (:background ,bg-hl :extend t))))
   `(line-number ((t (:foreground ,fg-dim :background ,bg))))
   `(line-number-current-line ((t (:foreground ,fg-cur :background ,bg-hl))))
   `(vertical-border ((t (:foreground ,bg-sep))))
   `(fill-column-indicator ((t (:foreground ,bg-sep))))
   `(minibuffer-prompt ((t (:foreground ,blue :weight bold))))
   `(link ((t (:foreground ,blue :underline t))))
   `(mode-line ((t (:background ,bg-hl :foreground ,fg :box (:line-width 1 :color ,bg-sep)))))
   `(mode-line-inactive ((t (:background ,bg :foreground ,fg-dim :box (:line-width 1 :color ,bg-sep)))))
   `(header-line ((t (:background ,bg-hl :foreground ,fg))))
   ;; search / matching
   `(isearch ((t (:background ,green :foreground ,bg :weight bold))))
   `(lazy-highlight ((t (:background ,sel :foreground ,green))))
   `(match ((t (:background ,sel :foreground ,green))))
   `(query-replace ((t (:background ,yellow :foreground ,bg))))
   `(show-paren-match ((t (:background ,paren :weight bold))))
   `(show-paren-mismatch ((t (:background ,red :foreground ,fg))))
   ;; status
   `(error ((t (:foreground ,red :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(success ((t (:foreground ,green :weight bold))))
   ;; syntax
   `(font-lock-comment-face ((t (:foreground ,comment))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,comment))))
   `(font-lock-doc-face ((t (:foreground ,red))))
   `(font-lock-string-face ((t (:foreground ,green))))
   `(font-lock-keyword-face ((t (:foreground ,fg :weight bold))))
   `(font-lock-builtin-face ((t (:foreground ,builtin))))
   `(font-lock-function-name-face ((t (:foreground ,blue))))
   `(font-lock-function-call-face ((t (:foreground ,blue))))
   `(font-lock-type-face ((t (:foreground ,blue))))
   `(font-lock-constant-face ((t (:foreground ,teal :weight bold))))
   `(font-lock-variable-name-face ((t (:foreground ,teal))))
   `(font-lock-variable-use-face ((t (:foreground ,teal))))
   `(font-lock-preprocessor-face ((t (:foreground ,green))))
   `(font-lock-number-face ((t (:foreground ,yellow))))
   `(font-lock-operator-face ((t (:foreground ,teal))))
   `(font-lock-escape-face ((t (:foreground ,blue))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,blue))))
   `(font-lock-warning-face ((t (:foreground ,red :underline t))))
   `(font-lock-negation-char-face ((t (:foreground ,yellow))))
   ;; misc
   `(flyspell-incorrect ((t (:underline (:style wave :color ,red)))))
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(diff-added ((t (:foreground ,green))))
   `(diff-removed ((t (:foreground ,red))))
   `(diff-changed ((t (:foreground ,yellow))))
   `(whitespace-tab ((t (:foreground "#373438"))))
   `(highlight-indent-guides-character-face ((t (:foreground ,bg-hl))))
   `(org-level-1 ((t (:foreground ,blue :weight bold))))
   `(org-level-2 ((t (:foreground ,teal :weight bold))))
   `(org-level-3 ((t (:foreground ,green :weight bold))))
   `(org-level-4 ((t (:foreground ,yellow))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(font-lock-import-face ((t (:foreground ,import))))
   `(bookmark-face ((t (:foreground ,teal))))
   `(breakpoint-disabled ((t (:foreground ,purple))))))

(provide-theme 'leaf-dark)
;;; leaf-dark-theme.el ends here
