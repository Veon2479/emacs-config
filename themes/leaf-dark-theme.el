;;; leaf-dark-theme.el --- Port of KDE Kate "Leaf Dark" -*- lexical-binding: t -*-

;; Source: https://github.com/qewer33/leaf-kde/blob/main/kate/Leaf%20Dark.theme

;;; Code:

(deftheme leaf-dark "Port of Kate Leaf Dark (qewer33/leaf-kde).")

(let ((bg       "#2e2c2f")
      (bg-hl    "#343235")
      (bg-sep   "#333134")
      (sel      "#515051")
      (paren    "#656066")
      (fg       "#e1e4dc")
      (fg-dim   "#737576")
      (fg-cur   "#cbcccf")
      (comment  "#7a7c7d")
      (builtin  "#7f8c8d")
      (green    "#729b79")
      (teal     "#489ca5")
      (blue     "#5292c6")
      (yellow   "#ccaa6c")
      (red      "#ba5860")
      (purple   "#8c6aa8")
      (import   "#27ae60"))
  (custom-theme-set-faces
   'leaf-dark
   ;; base UI
   `(default ((t (:background ,bg :foreground ,fg))))
   `(cursor ((t (:background ,fg))))
   `(fringe ((t (:background ,bg))))
   `(region ((t (:background ,sel :extend t))))
   `(hl-line ((t (:background ,bg-hl :extend t))))
   `(line-number ((t (:foreground ,fg-dim :background ,bg))))
   `(line-number-current-line ((t (:foreground ,fg-cur :background ,bg-hl))))
   `(vertical-border ((t (:foreground ,bg-sep))))
   `(fill-column-indicator ((t (:foreground ,bg-sep))))
   `(minibuffer-prompt ((t (:foreground ,green :weight bold))))
   `(link ((t (:foreground ,green :underline t))))
   `(mode-line ((t (:background ,bg-hl :foreground ,fg :box (:line-width 1 :color ,bg-sep)))))
   `(mode-line-inactive ((t (:background ,bg :foreground ,fg-dim :box (:line-width 1 :color ,bg-sep)))))
   `(header-line ((t (:background ,bg-hl :foreground ,fg))))
   ;; accent (hover / pressed)
   `(highlight ((t (:background ,green :foreground ,bg))))
   `(mode-line-highlight ((t (:box (:line-width 1 :color ,green)))))
   `(custom-button-mouse ((t (:background ,green :foreground ,bg))))
   `(custom-button-pressed ((t (:background ,green :foreground ,bg))))
   `(widget-button-pressed ((t (:foreground ,green))))
   `(tab-bar-tab ((t (:background ,bg-hl :foreground ,fg :underline (:color ,green)))))
   `(tab-bar-tab-inactive ((t (:background ,bg :foreground ,fg-dim))))
   ;; remaining default blues
   `(secondary-selection ((t (:background ,sel :foreground ,green :extend t))))
   `(tooltip ((t (:background ,bg-hl :foreground ,fg))))
   `(tab-bar ((t (:background ,bg :foreground ,fg-dim))))
   `(tab-line ((t (:background ,bg :foreground ,fg-dim))))
   `(tool-bar ((t (:background ,bg :foreground ,fg))))
   `(menu ((t (:background ,bg-hl :foreground ,fg))))
   `(completions-common-part ((t (:foreground ,green))))
   `(completions-first-difference ((t (:foreground ,yellow :weight bold))))
   `(completions-highlight ((t (:background ,green :foreground ,bg))))
   `(completions-annotations ((t (:foreground ,comment))))
   `(button ((t (:foreground ,green :underline t))))
   `(info-xref ((t (:foreground ,green :underline t))))
   `(info-menu-star ((t (:foreground ,yellow))))
   `(compilation-info ((t (:foreground ,green :weight bold))))
   `(compilation-line-number ((t (:foreground ,yellow))))
   ;; key hints
   `(help-key-binding ((t (:foreground ,green :background ,bg-hl :box (:line-width -1 :color ,bg-sep)))))
   `(which-key-key-face ((t (:foreground ,green :weight bold))))
   `(which-key-command-description-face ((t (:foreground ,fg))))
   `(which-key-group-description-face ((t (:foreground ,yellow))))
   `(which-key-local-map-description-face ((t (:foreground ,fg))))
   `(which-key-separator-face ((t (:foreground ,comment))))
   `(transient-key ((t (:foreground ,green :weight bold))))
   `(transient-key-stay ((t (:foreground ,green :weight bold))))
   `(transient-key-exit ((t (:foreground ,yellow :weight bold))))
   `(transient-key-return ((t (:foreground ,yellow :weight bold))))
   `(transient-key-noop ((t (:foreground ,fg-dim))))
   `(transient-heading ((t (:foreground ,green :weight bold))))
   ;; dired
   `(dired-directory ((t (:foreground ,green :weight bold))))
   `(dired-symlink ((t (:foreground ,teal))))
   `(dired-broken-symlink ((t (:foreground ,red :underline t))))
   `(dired-header ((t (:foreground ,green :weight bold))))
   `(dired-mark ((t (:foreground ,yellow :weight bold))))
   `(dired-marked ((t (:foreground ,yellow :weight bold))))
   `(dired-flagged ((t (:foreground ,red :weight bold))))
   `(dired-perm-write ((t (:foreground ,fg-dim))))
   `(dired-special ((t (:foreground ,purple))))
   `(dired-ignored ((t (:foreground ,comment))))
   ;; ibuffer
   `(ibuffer-title-face ((t (:foreground ,green :weight bold))))
   `(ibuffer-marked-face ((t (:foreground ,yellow :weight bold))))
   `(ibuffer-deletion-face ((t (:foreground ,red :weight bold))))
   ;; search / matching
   `(isearch ((t (:background ,green :foreground ,bg :weight bold))))
   `(lazy-highlight ((t (:background ,sel :foreground ,green))))
   `(match ((t (:background ,sel :foreground ,green))))
   `(query-replace ((t (:background ,yellow :foreground ,bg))))
   `(show-paren-match ((t (:background ,paren :weight bold))))
   `(show-paren-mismatch ((t (:background ,red :foreground ,fg))))
   ;; status
   `(error ((t (:foreground ,red :weight bold))))
   `(warning ((t (:foreground ,yellow :weight bold))))
   `(success ((t (:foreground ,green :weight bold))))
   ;; syntax
   `(font-lock-comment-face ((t (:foreground ,comment))))
   `(font-lock-comment-delimiter-face ((t (:foreground ,comment))))
   `(font-lock-doc-face ((t (:foreground ,red))))
   `(font-lock-string-face ((t (:foreground "#f44f4f"))))
   `(font-lock-keyword-face ((t (:foreground ,fg :weight bold))))
   `(font-lock-builtin-face ((t (:foreground ,builtin))))
   `(font-lock-function-name-face ((t (:foreground ,blue))))
   `(font-lock-function-call-face ((t (:foreground ,blue))))
   `(font-lock-type-face ((t (:foreground ,blue))))
   `(font-lock-constant-face ((t (:foreground ,teal :weight bold))))
   `(font-lock-variable-name-face ((t (:foreground ,teal))))
   `(font-lock-variable-use-face ((t (:foreground ,teal))))
   `(font-lock-preprocessor-face ((t (:foreground ,green))))
   `(font-lock-number-face ((t (:foreground ,yellow))))
   `(font-lock-operator-face ((t (:foreground ,teal))))
   `(font-lock-escape-face ((t (:foreground ,blue))))
   `(font-lock-regexp-grouping-backslash ((t (:foreground ,blue))))
   `(font-lock-warning-face ((t (:foreground ,red :underline t))))
   `(font-lock-negation-char-face ((t (:foreground ,yellow))))
   ;; misc
   `(flyspell-incorrect ((t (:underline (:style wave :color ,red)))))
   `(flymake-error ((t (:underline (:style wave :color ,red)))))
   `(flymake-warning ((t (:underline (:style wave :color ,yellow)))))
   `(diff-added ((t (:foreground ,green))))
   `(diff-removed ((t (:foreground ,red))))
   `(diff-changed ((t (:foreground ,yellow))))
   `(whitespace-tab ((t (:foreground "#373438"))))
   `(highlight-indent-guides-character-face ((t (:foreground ,bg-hl))))
   `(org-level-1 ((t (:foreground ,blue :weight bold))))
   `(org-level-2 ((t (:foreground ,teal :weight bold))))
   `(org-level-3 ((t (:foreground ,green :weight bold))))
   `(org-level-4 ((t (:foreground ,yellow))))
   `(org-todo ((t (:foreground ,red :weight bold))))
   `(org-done ((t (:foreground ,green :weight bold))))
   `(font-lock-import-face ((t (:foreground ,import))))
   `(bookmark-face ((t (:foreground ,teal))))
   `(breakpoint-disabled ((t (:foreground ,purple))))

   `(rainbow-delimiters-depth-1-face ((t (:foreground "#4fc1ff"))))
   `(rainbow-delimiters-depth-2-face ((t (:foreground "#ffd700"))))
   `(rainbow-delimiters-depth-3-face ((t (:foreground "#7ee787"))))
   `(rainbow-delimiters-depth-4-face ((t (:foreground "#ff79c6"))))
   `(rainbow-delimiters-depth-5-face ((t (:foreground "#ff9e3b"))))
   `(rainbow-delimiters-depth-6-face ((t (:foreground "#bd93f9"))))
   `(rainbow-delimiters-depth-7-face ((t (:foreground "#4fc1ff"))))
   `(rainbow-delimiters-depth-8-face ((t (:foreground "#ffd700"))))
   `(rainbow-delimiters-depth-9-face ((t (:foreground "#7ee787"))))
   `(rainbow-delimiters-unmatched-face ((t (:foreground "#ffffff" :background "#f44f4f" :weight bold))))

   )

  )

(provide-theme 'leaf-dark)
;;; leaf-dark-theme.el ends here
